# Copy this file to .devcontainer/.env and fill in the values.
# .env is gitignored — never commit it.

# Secrets do not belong in this workspace file. Export GH_TOKEN in the host
# environment before opening the Shared Container; devcontainer.json passes
# it directly to the agent-operation identity and the code runner scrubs it.
# Use a repository-scoped fine-grained PAT:
# https://github.com/settings/tokens

# Optional: override git identity (defaults to Ken Sørevåge if unset)
# GIT_USER_EMAIL=you@example.com
# GIT_USER_NAME=Your Name


# Your host machine's hostname — used to label the SSH keys if your credential
# directory uses host-specific names.
DEVCONTAINER_HOST=your-hostname-here

# Export this in the host environment instead of placing private keys in the
# Shared Checkout. The directory must contain deploy-key and signing-key,
# both mode 0600.
# DEVCONTAINER_CREDENTIALS_DIR=/absolute/path/to/devcontainer-credentials
