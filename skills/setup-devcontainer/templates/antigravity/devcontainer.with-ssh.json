{
  "name": "Antigravity",
  "dockerComposeFile": ["../docker-compose.yml"],
  "service": "antigravity",
  "workspaceFolder": "/workspace",
  "shutdownAction": "none",
  "remoteUser": "vscode",
  "init": true,
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.initialHint": false
      }
    }
  },
  "mounts": [
    "source={{REPO_NAME}}-ssh-config,target=/home/vscode/.ssh,type=volume"
  ],
  "initializeCommand": "test -f \"${localWorkspaceFolder}/.devcontainer/.env\" || cp \"${localWorkspaceFolder}/.devcontainer/.env.example\" \"${localWorkspaceFolder}/.devcontainer/.env\"",
  "postCreateCommand": "bash .devcontainer/antigravity/post-create.sh",
  "postStartCommand": "bash .devcontainer/antigravity/post-start.sh",
  "postAttachCommand": "bash .devcontainer/post-attach.sh",
  "waitFor": "postStartCommand"
}
