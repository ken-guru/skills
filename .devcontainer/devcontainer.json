{
  "name": "skills devcontainer",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "remoteUser": "vscode",
  "init": true,
  "containerEnv": {
    "BASH_ENV": "/workspace/.devcontainer/bash-env.sh",
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },
  "mounts": [
    "source=skills-config,target=/home/vscode,type=volume",
    "source=skills-ssh,target=/home/vscode/.ssh,type=volume",
    "source=${localEnv:DEVCONTAINER_CREDENTIALS_DIR},target=/run/devcontainer-credentials,type=bind,consistency=cached,readonly"
  ],
  "runArgs": [
    "--cap-add=SYS_ADMIN",
    "--security-opt=seccomp=unconfined",
    "--security-opt=systempaths=unconfined"
  ],
  "initializeCommand": "test -f \"${localWorkspaceFolder}/.devcontainer/.env\" || cp \"${localWorkspaceFolder}/.devcontainer/.env.example\" \"${localWorkspaceFolder}/.devcontainer/.env\"",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "waitFor": "postAttachCommand",
  "postAttachCommand": "bash .devcontainer/post-attach.sh"
}
