{
  "$schema": "../theme.schema.json",
  "id": "compact-signal",
  "name": "Compact Signal",
  "description": "Compact, clear, and high-contrast for information-dense stories with supportive or full-bleed imagery.",
  "packageVersion": "1.0.0",
  "markupVersion": 1,
  "marpTheme": "compact-signal",
  "css": "theme.css",
  "fonts": {
    "display": ["Source Serif Pro", "Georgia", "serif"],
    "body": ["Source Sans Pro", "Arial", "Helvetica", "sans-serif"],
    "label": ["Source Sans Pro", "Arial", "Helvetica", "sans-serif"],
    "genericFallback": "sans-serif"
  },
  "palette": {
    "background": "#f7f7f7",
    "foreground": "#012a4c",
    "accent": "#005b91",
    "secondary": "#00ab84",
    "highlight": "#f7b715",
    "dark": "#012a4c",
    "light": "#ffffff",
    "signal": "#e83f53",
    "cyan": "#009fe3",
    "muted": "#828282"
  },
  "media": {
    "pictureTreatment": "Crisp documentary or editorial imagery with clear focal subjects, restrained saturation, clean edges, and either a supportive side panel or full-bleed composition.",
    "diagramTreatment": "Precise dark-blue linework with blue, teal, yellow, and red semantic accents on a clean light field; labels remain exact, legible, and uncropped."
  },
  "archetypes": {
    "title": {
      "class": "archetype-title",
      "tone": "tone-dark",
      "slots": ["title", "subtitle", "media"],
      "capacity": {"titleLines": 3, "subtitleLines": 2},
      "variations": [{"id": "default", "class": "variation-default", "when": "always"}]
    },
    "section": {
      "class": "archetype-section",
      "tone": "tone-accent",
      "slots": ["title", "orientation"],
      "capacity": {"titleLines": 3, "orientationLines": 2},
      "variations": [{"id": "default", "class": "variation-default", "when": "always"}]
    },
    "text-only": {
      "class": "archetype-text-only",
      "tone": "tone-light",
      "slots": ["heading", "body"],
      "capacity": {"headingLines": 2, "bullets": 6, "bulletLines": 2},
      "variations": [{"id": "default", "class": "variation-default", "when": "always"}]
    },
    "text-plus-image": {
      "class": "archetype-text-plus-image",
      "tone": "tone-light",
      "slots": ["heading", "body", "media", "caption"],
      "capacity": {"headingLines": 2, "bullets": 5, "bulletLines": 2, "captionLines": 2},
      "variations": [
        {"id": "portrait", "class": "variation-portrait", "when": "orientation=portrait"},
        {"id": "landscape", "class": "variation-landscape", "when": "orientation=landscape"},
        {"id": "full-image", "class": "variation-full-image", "when": "orientation=full-image"}
      ]
    },
    "data": {
      "class": "archetype-data",
      "tone": "tone-light",
      "slots": ["heading", "metrics", "media", "takeaway"],
      "capacity": {"headingLines": 2, "charts": 1, "metrics": 4, "takeawayLines": 2},
      "variations": [{"id": "default", "class": "variation-default", "when": "always"}]
    },
    "diagram": {
      "class": "archetype-diagram",
      "tone": "tone-light",
      "slots": ["heading", "media", "caption"],
      "capacity": {"headingLines": 2, "diagrams": 1, "captionLines": 2},
      "variations": [{"id": "default", "class": "variation-default", "when": "always"}]
    },
    "quotation": {
      "class": "archetype-quotation",
      "tone": "tone-dark",
      "slots": ["quote", "attribution", "context"],
      "capacity": {"quoteLines": 4, "attributionLines": 2, "contextLines": 1},
      "variations": [{"id": "default", "class": "variation-default", "when": "always"}]
    }
  },
  "assets": []
}
