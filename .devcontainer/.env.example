# Copy this file to .devcontainer/.env and fill in the values.
# .env is gitignored — never commit it.

# GitHub token used by the `gh` CLI inside the container for API operations
# (PRs, issues, etc). A fine-grained PAT scoped to this repo is recommended:
# https://github.com/settings/tokens

GH_TOKEN=ghp_your_token_here

# Optional: override git identity (defaults to Ken Sørevåge if unset)
# GIT_USER_EMAIL=you@example.com
# GIT_USER_NAME=Your Name

# --- Claude Code CLI version pin (added by setup-devcontainer) ---
# Claude Code CLI version: "latest" always installs the newest release via
# npm and keeps auto-updating in the background afterward, matching the
# vendor's own default behavior; pin an exact version (e.g. 2.1.265) to
# lock it instead — the pin also disables Claude Code's own auto-updater
# (via DISABLE_UPDATES in managed settings), so a pinned version stays
# pinned. To go back to always-latest, set this to "latest" (or delete the
# line), then rebuild.
CLAUDE_CODE_VERSION=latest

# --- Codex CLI version pin (added by setup-devcontainer) ---
# Codex CLI version: "latest" always installs the newest release via npm,
# matching the vendor's own default; pin an exact version (e.g. 0.154.0) to
# lock it instead. Codex has no background auto-updater to fight — it only
# updates via the explicit `codex update` command — so a pin here holds on
# its own, no extra setting needed. To go back to always-latest, set this
# to "latest" (or delete the line), then rebuild.
CODEX_VERSION=latest
