
# Optional non-secret host label for setup messages.
DEVCONTAINER_HOST=your-hostname-here

# Export this in the host environment. It must contain deploy-key,
# deploy-key.pub, signing-key, and signing-key.pub, each private key mode 0600
# or 0400. The directory is mounted read-only outside the Shared Checkout.
# DEVCONTAINER_CREDENTIALS_DIR=/absolute/path/to/devcontainer-credentials
