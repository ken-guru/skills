# Copy this file to .devcontainer/.env and fill in the values.
# .env is gitignored — never commit it.

# Secrets do not belong in this workspace file. Export GH_TOKEN in the host
# environment before opening the Shared Container; devcontainer.json passes
# it directly to the agent-operation identity and the code runner scrubs it.
# Use a repository-scoped fine-grained PAT:
# https://github.com/settings/tokens

# Optional: override git identity (defaults to {{GIT_NAME_DEFAULT}} if unset)
# GIT_USER_EMAIL=you@example.com
# GIT_USER_NAME=Your Name

# Optional: explicitly accept a weaker security posture when a required
# check can't pass in this environment (e.g. no ACL support, no protected
# credential mount) — a comma-separated list of check names, or "all".
# Every opted-out check keeps warning on every terminal until fixed. Leave
# unset: every check fails closed by default.
# DEVCONTAINER_ACCEPT_RESIDUAL_RISK=ssh-credentials,workspace-acl
