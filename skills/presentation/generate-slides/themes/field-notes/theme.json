{
  "$schema": "../theme.schema.json",
  "id": "field-notes",
  "name": "Field Notes",
  "description": "Tactile, natural, and shaped like a documented working session.",
  "packageVersion": "1.1.0",
  "markupVersion": 1,
  "marpTheme": "field-notes",
  "css": "theme.css",
  "fonts": {
    "display": ["Georgia", "Times New Roman", "serif"],
    "body": ["Trebuchet MS", "Arial", "sans-serif"],
    "label": ["Trebuchet MS", "Arial", "sans-serif"],
    "genericFallback": "sans-serif"
  },
  "palette": {
    "background": "#e8e0cb",
    "foreground": "#2e3d31",
    "accent": "#b84630",
    "secondary": "#8b6a00",
    "sage": "#63775e",
    "dark": "#2e3d31",
    "light": "#f7f2e7",
    "muted": "#405444"
  },
  "media": {
    "pictureTreatment": "Natural documentary photography with warm paper color, restrained saturation, visible human process, honest texture, and generous protected focal regions for print-like framing.",
    "diagramTreatment": "Organic but exact sage, mustard, and coral annotation on a protected paper panel; annotations stay outside labels, nodes, connectors, and semantic colors."
  },
  "diagramRoles": {
    "base": {"fill": "light", "stroke": "foreground", "fontColor": "foreground", "strokeDash": 0, "fontSize": 28},
    "emphasis": {"fill": "foreground", "stroke": "foreground", "fontColor": "light", "strokeDash": 0, "fontSize": 28},
    "muted": {"fill": "background", "stroke": "muted", "fontColor": "muted", "strokeDash": 0, "fontSize": 28},
    "risk": {"fill": "accent", "stroke": "accent", "fontColor": "light", "strokeDash": 0, "fontSize": 28},
    "boundary": {"fill": "background", "stroke": "sage", "fontColor": "foreground", "strokeDash": 4, "fontSize": 28},
    "flow": {"stroke": "foreground", "fontColor": "foreground", "strokeDash": 0, "fontSize": 24},
    "optional-flow": {"stroke": "muted", "fontColor": "muted", "strokeDash": 5, "fontSize": 24},
    "risk-flow": {"stroke": "accent", "fontColor": "accent", "strokeDash": 0, "fontSize": 24}
  },
  "archetypes": {
    "title": {
      "class": "archetype-title",
      "tone": "tone-light",
      "slots": ["title", "subtitle", "media"],
      "capacity": {"titleLines": 3, "subtitleLines": 2},
      "variations": [{"id": "default", "class": "variation-default", "when": "always"}]
    },
    "section": {
      "class": "archetype-section",
      "tone": "tone-light",
      "slots": ["title", "orientation"],
      "capacity": {"titleLines": 3, "orientationLines": 2},
      "variations": [{"id": "default", "class": "variation-default", "when": "always"}]
    },
    "text-only": {
      "class": "archetype-text-only",
      "tone": "tone-light",
      "slots": ["heading", "body"],
      "capacity": {"headingLines": 2, "bullets": 5, "bulletLines": 2},
      "variations": [{"id": "default", "class": "variation-default", "when": "always"}]
    },
    "text-plus-image": {
      "class": "archetype-text-plus-image",
      "tone": "tone-light",
      "slots": ["heading", "body", "media", "caption"],
      "capacity": {"headingLines": 2, "bullets": 4, "bulletLines": 2, "captionLines": 2},
      "variations": [
        {"id": "portrait", "class": "variation-portrait", "when": "orientation=portrait"},
        {"id": "landscape", "class": "variation-landscape", "when": "orientation=landscape"},
        {"id": "full-image", "class": "variation-full-image", "when": "orientation=full-image"}
      ]
    },
    "data": {
      "class": "archetype-data",
      "tone": "tone-light",
      "slots": ["heading", "metrics", "media", "takeaway"],
      "capacity": {"headingLines": 2, "charts": 1, "metrics": 4, "takeawayLines": 2},
      "variations": [{"id": "default", "class": "variation-default", "when": "always"}]
    },
    "diagram": {
      "class": "archetype-diagram",
      "tone": "tone-light",
      "slots": ["heading", "media", "caption"],
      "capacity": {"headingLines": 2, "diagrams": 1, "captionLines": 2},
      "variations": [{"id": "default", "class": "variation-default", "when": "always"}]
    },
    "quotation": {
      "class": "archetype-quotation",
      "tone": "tone-light",
      "slots": ["quote", "attribution", "context"],
      "capacity": {"quoteLines": 4, "attributionLines": 2, "contextLines": 1},
      "variations": [{"id": "default", "class": "variation-default", "when": "always"}]
    }
  },
  "assets": []
}
