# Copy this file to .devcontainer/.env and fill in the values.
# .env is gitignored — never commit it.

# GitHub token used by the `gh` CLI inside the container for API operations
# (PRs, issues, etc). A fine-grained PAT scoped to this repo is recommended:
# https://github.com/settings/personal-access-tokens/new
# Set its resource owner to this repo's owner — the organization, for an
# org-owned repo — or it can't reach the repo.
# Deploy-key registration is manual by default (see the SSH setup prompt after
# first attach) and needs no extra permission. Optional: grant this repo's
# Administration (read/write) permission too if you'd rather the deploy key
# auto-register itself — plus whatever else you use gh for.

GH_TOKEN=github_pat_your_token_here

# Optional: override git identity (defaults to Ken Sørevåge if unset)
# GIT_USER_EMAIL=you@example.com
# GIT_USER_NAME=Your Name

# Your host machine's hostname — used to label the SSH deploy/signing keys so
# you can identify and revoke them per machine from GitHub. Run `hostname` in
# your terminal to find it. Required for SSH key generation to run at all —
# unlike GH_TOKEN, nothing below can degrade gracefully without it.
DEVCONTAINER_HOST=your-hostname-here

# --- Copilot token ---
# GitHub Copilot CLI's own token, read before GH_TOKEN. It must be a
# fine-grained PAT whose resource owner is your personal account, with only
# the "Copilot Requests" account permission and no repository access.
# Classic (ghp_) and org-owned tokens can't authorize Copilot. Create one at
# https://github.com/settings/personal-access-tokens/new, then uncomment:
# COPILOT_GITHUB_TOKEN=github_pat_your_token_here
