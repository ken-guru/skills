
# Copilot CLI version: "latest" always installs the newest release on every
# rebuild; pin an exact version (e.g. 0.0.354) to lock it instead. When
# pinned, a stale-version notice appears in new terminals once a newer
# release exists, telling you what to change here and that a rebuild is
# required.
COPILOT_CLI_VERSION={{COPILOT_CLI_VERSION}}
