# Generated by setup-devcontainer's host-side walkthrough. Copy to
# `.envrc` at this repo's root (sibling to `.git/`, not inside
# `.devcontainer/`) and run `direnv allow`. .envrc is gitignored — never
# commit it, it can carry GH_TOKEN.
export GH_TOKEN={{GH_TOKEN}}
# Only if the SSH layer is enabled for this repo:
export DEVCONTAINER_CREDENTIALS_DIR={{CREDENTIAL_DIR}}
