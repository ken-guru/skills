
# --- Claude Code CLI version pin (added by setup-devcontainer) ---
# Claude Code CLI version: "latest" always installs the newest release and
# keeps auto-updating in the background afterward, matching the vendor's own
# default behavior; pin an exact version (e.g. 2.1.89) to lock it instead.
# When pinned, a stale-version notice appears in new terminals once a newer
# release exists, telling you what to change here and that a rebuild is
# required. To go back to always-latest, set this to "latest" (or delete
# the line) and set DISABLE_AUTOUPDATER below back to "false", then rebuild.
CLAUDE_CODE_VERSION={{CLAUDE_CODE_VERSION}}

# Stops Claude Code's own background auto-updater. Only meaningful — and
# only set to "1" — when CLAUDE_CODE_VERSION above is pinned to an exact
# version: otherwise the auto-updater would silently move you past the pin
# shortly after install, making the pin pointless. Leave "false" when
# CLAUDE_CODE_VERSION is "latest".
DISABLE_AUTOUPDATER={{DISABLE_AUTOUPDATER}}
