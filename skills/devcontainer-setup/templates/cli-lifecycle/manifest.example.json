{
  "_comment": "Skeleton shape for an auto-updated developer-tool manifest. One entry per tool; the age-gate check script reads this file directly. Replace every <placeholder> before use.",

  "startupUpdate": {
    "timeoutSeconds": 120
  },

  "<tool-a-key>": {
    "binary": "<tool-a-binary-name>",
    "installer": "registry-package",
    "package": "<registry-package-name>",
    "version": "<pinned-baseline-version>",
    "versionPolicy": "auto-update",
    "minimumReleaseAgeDays": 3,
    "versionCheck": {
      "registry": "https://<package-registry-host>"
    }
  },

  "<tool-b-key>": {
    "binary": "<tool-b-binary-name>",
    "installer": "pinned-release",
    "version": "<pinned-baseline-version>",
    "versionPolicy": "auto-update",
    "minimumReleaseAgeDays": 3,
    "releaseManifest": "https://<vendor-host>/manifests/{platform}.json",
    "releases": {
      "<platform-a>": {
        "url": "https://<vendor-host>/releases/<pinned-baseline-version>/<platform-a>.tar.gz",
        "sha512": "<expected-sha512-of-the-pinned-archive>"
      },
      "<platform-b>": {
        "url": "https://<vendor-host>/releases/<pinned-baseline-version>/<platform-b>.tar.gz",
        "sha512": "<expected-sha512-of-the-pinned-archive>"
      }
    }
  },

  "<tool-c-key>": {
    "binary": "<tool-c-binary-name>",
    "installer": "vendor-feature",
    "version": "<pinned-baseline-version>",
    "versionPolicy": "auto-update",
    "minimumReleaseAgeDays": 3,
    "versionCheck": {
      "registry": "https://<package-registry-host>"
    }
  },

  "<tool-d-key>": {
    "binary": "<tool-d-binary-name>",
    "installer": "self-updating",
    "_comment": "This tool ships its own updater with no discoverable disable flag and no way for this container to control update timing. minimumReleaseAgeDays does not apply: there is no update decision to gate, only drift to detect. baselineVersion is recorded once at wiring time; the age-gate check compares it against '<binary> --version' every cycle and logs a warning on mismatch instead of holding or installing anything.",
    "versionPolicy": "detect-drift",
    "baselineVersion": "<version-recorded-when-first-wired-up>"
  }
}
