{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ken-guru.local/schemas/presentation-theme.json",
  "title": "Presentation Theme Manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "packageVersion",
    "markupVersion",
    "marpTheme",
    "css",
    "fonts",
    "palette",
    "media",
    "archetypes",
    "assets"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "packageVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "markupVersion": {"type": "integer", "minimum": 1},
    "marpTheme": {"type": "string", "minLength": 1},
    "css": {"type": "string", "minLength": 1},
    "fonts": {
      "type": "object",
      "required": ["display", "body", "label", "genericFallback"],
      "properties": {
        "display": {"$ref": "#/$defs/fontStack"},
        "body": {"$ref": "#/$defs/fontStack"},
        "label": {"$ref": "#/$defs/fontStack"},
        "genericFallback": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "palette": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
    },
    "media": {
      "type": "object",
      "required": ["pictureTreatment", "diagramTreatment"],
      "properties": {
        "pictureTreatment": {"type": "string", "minLength": 1},
        "diagramTreatment": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "archetypes": {
      "type": "object",
      "required": ["title", "section", "text-only", "text-plus-image", "data", "diagram", "quotation"],
      "properties": {
        "title": {"$ref": "#/$defs/archetype"},
        "section": {"$ref": "#/$defs/archetype"},
        "text-only": {"$ref": "#/$defs/archetype"},
        "text-plus-image": {"$ref": "#/$defs/archetype"},
        "data": {"$ref": "#/$defs/archetype"},
        "diagram": {"$ref": "#/$defs/archetype"},
        "quotation": {"$ref": "#/$defs/archetype"}
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fontStack": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "variation": {
      "type": "object",
      "required": ["id", "class", "when"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "class": {"type": "string", "pattern": "^variation-[a-z0-9-]+$"},
        "when": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "archetype": {
      "type": "object",
      "required": ["class", "tone", "slots", "capacity", "variations"],
      "properties": {
        "class": {"type": "string", "pattern": "^archetype-[a-z0-9-]+$"},
        "tone": {"type": "string", "pattern": "^tone-[a-z0-9-]+$"},
        "slots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "capacity": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "variations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/variation"}
        }
      },
      "additionalProperties": false
    }
  }
}
