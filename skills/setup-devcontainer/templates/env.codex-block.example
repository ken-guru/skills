
# --- Codex CLI version pin (added by setup-devcontainer) ---
# Codex CLI version: "latest" always installs the newest release via npm,
# matching the vendor's own default; pin an exact version (e.g. 0.154.0) to
# lock it instead. Codex has no background auto-updater to fight — it only
# updates via the explicit `codex update` command — so a pin here holds on
# its own, no extra setting needed. To go back to always-latest, set this
# to "latest" (or delete the line), then rebuild.
CODEX_VERSION={{CODEX_VERSION}}
